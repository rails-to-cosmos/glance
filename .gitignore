.stack-work/
*~
/.direnv/
/.history
/.org-repl-history
/dist-newstyle/
/dist-newstyle-native/

# `make dist' assembles a throwaway per-system bundle here; it is rebuilt whole.
/dist/
*.sqlite

# Devenv
.devenv*
devenv.local.nix

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
/TAGS
*.hs#
*.imports
/report.html
/.haskdogs/
/tags
/lib
*.bak
/*.*#
.agnostic-llm/

# haskell-gi writes the bindings it generates into the package it generates
# them for, so the vendored sources grow a GI/ tree at configure time.
/vendored/*/GI/

# elm's own build cache, written beside the source it compiles.
/frontend/elm/elm-stuff/
/frontend/elm/tests/elm-stuff/
*.elm#
