cabal-version: 3.0

name:           glance
version:        0.7.0.1
synopsis:       A browser front end for org-mode files: a keyboard-driven table that writes back by span splice
description:    Org-mode projections: the org files are the source of truth, and
                everything else is a projection of them.
                Glance serves an org tree as a keyboard-driven table in a browser
                tab and writes back into the files by span splice, under an
                optimistic lock and leaving every other byte identical.  The
                in-memory store, the index and every view are rebuildable from
                the text.
                .
                One of two front ends over one set of bytes: Emacs's org-glance
                for editing and history, this for the table, the filter and the
                keyboard, each notifying the other through EXTERNAL.jsonl.
                .
                Please see the README on GitHub at <https://github.com/rails-to-cosmos/glance#readme>
category:       Text, Web
homepage:       https://github.com/rails-to-cosmos/glance#readme
bug-reports:    https://github.com/rails-to-cosmos/glance/issues
author:         Dmitry Akatov
maintainer:     dmitry.akatov@protonmail.com
copyright:      2023-2026 Dmitry Akatov
license:        Apache-2.0
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    CHANGELOG.md
    -- The renderer glance-web compiles in; vendored by `make sync-renderer'.
    assets/table-view.js
    -- The shell's stylesheet, embedded by `Glance.Web.Page.Style'.
    assets/page.css
    -- And the shell, one widget per file, in `Glance.Web.Base.gluePartFiles' order.
    frontend/glue/*.js
    -- The Elm programs, compiled to one file by `make elm'.
    assets/elm.js
    test/fixtures/*.js
    test/fixtures/*.json
    test/fixtures/assets/*.js
    test/fixtures/assets/glue/*.js
    test/fixtures/broken/*.org
    test/fixtures/subtree/*.org
    test/fixtures/view/*.org

source-repository head
  type: git
  location: https://github.com/rails-to-cosmos/glance

-- Build `glance desktop''s own WebKitGTK window.  Off and manual: on, the solver
-- pulls the haskell-gi tree and the build needs GTK3/WebKitGTK headers.
-- The flag alone is not enough -- `make native' adds `vendored/' and the GIR path.
flag native-window
  description: Build the native WebKitGTK window (gi-gtk 3 + gi-webkit2).
  default: False
  manual: True

-- crypton is unbuildable on wasm32-wasi; on, the SHA-256 digest and the sixteen
-- random bytes come from pure Haskell (docs/proposals/2026-08-05-native-ports.draft.md).
flag pure-crypto
  description: Pure-Haskell digest and entropy (wasm32-wasi has no crypton).
  default: False
  manual: True

-- The parser and its AST.  Private: nothing outside this package reaches past the facade.
library glance-internal
  visibility: private
  exposed-modules:
      Data.Org
      Data.Org.Blob
      Data.Org.Config
      Data.Org.Doctor
      Data.Org.Edit
      Data.Org.External
      Data.Org.Index
      Data.Org.Trash
      Data.Org.Types
      Data.Org.Parser
      Data.Org.Walk
      Repl.Org
  hs-source-dirs:
      src
  default-extensions:
      FlexibleInstances
      GADTs
      OverloadedRecordDot
      OverloadedStrings
      RecordWildCards
  ghc-options: -Wall -Werror=incomplete-patterns -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    -- Read-only, and for ONE foreign format: org-glance's JSONL index.  No internal
    -- type gains a 'ToJSON' by it -- the wire stays hand-built (AGENTS.hs).
    , aeson
    , async
    , bytestring
    , containers
    , directory
    , filepath
    , haskeline
    , megaparsec
    , mtl
    , text
    , text-show
    , time
    , unix
    -- Already in the plan behind wai-extra's gzip middleware; naming it fetches nothing.
    , zlib
  if flag(pure-crypto)
    build-depends:
        SHA
      , random
    cpp-options: -DPURE_CRYPTO
  else
    build-depends:
        crypton
  default-language: Haskell2010

-- The public library: everything outside this package sees only 'Glance.Query'.
library
  exposed-modules:
      Glance.Query
  hs-source-dirs:
      src-query
  default-extensions:
      OverloadedStrings
  ghc-options: -Wall -Werror=incomplete-patterns -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , aeson
    , bytestring
    , containers
    , glance:glance-internal
    , text
    , text-show
    , time
  default-language: Haskell2010

-- The one-shot migration engine `glance backfill-created' drives.  Private, on
-- the public library plus the parser: it needs `Glance.Query''s stamp and drawer
-- splice AND `Data.Org''s walk and parse, so it sits above the facade, not in it.
library glance-migrate
  visibility: private
  exposed-modules:
      Glance.Backfill
  hs-source-dirs:
      src-migrate
  default-extensions:
      OverloadedStrings
  ghc-options: -Wall -Werror=incomplete-patterns -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , containers
    -- Reads a file's mtime for the migration's evidence tier.
    , directory
    , glance:{glance, glance-internal}
    , text
    , text-show
    , time
  default-language: Haskell2010

-- The web layer.  Private, on the public library alone: the facade constraint
-- (AGENTS.hs) is a solver error here, since reaching Data.Org.* would show up below.
library glance-web
  visibility: private
  exposed-modules:
      Glance.Desktop
      Glance.Desktop.Native
      Glance.Web
      Glance.Web.Base
      Glance.Web.Columns
      Glance.Web.Commands
      Glance.Web.Filter
      Glance.Web.Keymap
      Glance.Web.Page
      Glance.Web.Page.Glue
      Glance.Web.Page.Popups
      Glance.Web.Page.Style
      Glance.Web.Routes
      Glance.Web.Sort
      Glance.Web.Store
      Glance.Web.Theme
      Glance.Web.Theme.Default
      Glance.Web.Theme.Types
      Glance.Web.Watch
  hs-source-dirs:
      src-web
  default-extensions:
      OverloadedStrings
      RecordWildCards
  ghc-options: -Wall -Werror=incomplete-patterns -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , aeson
    , bytestring
    , containers
    , directory
    , file-embed
    , filepath
    , fsnotify
    , glance:glance
    , http-types
    , process
    , stm
    -- `Routes' folds `gluePartFiles' into one embed per part, a TH list expression.
    , template-haskell
    , text
    , time
    , wai
    , wai-extra
    , wai-websockets
    , warp
    , websockets
  default-language: Haskell2010

-- The native window and nothing else.  Always built and trivial when
-- `native-window' is off, which keeps the flag out of every other stanza.
library glance-desktop-native
  visibility: private
  exposed-modules:
      Glance.Desktop.WebKit
  hs-source-dirs:
      src-desktop-native
  ghc-options: -Wall -Werror=incomplete-patterns -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
  if flag(native-window)
    cpp-options: -DNATIVE_WINDOW
    -- gi-gtk3/gi-gdk3 are the names gi-webkit2 depends on; the other spelling
    -- puts two packages claiming GI.Gtk in one plan.
    build-depends:
        gi-gdk3 >=3.0 && <3.1
      , gi-glib >=2.0 && <2.1
      , gi-gtk3 >=3.0 && <3.1
      -- Reads the URL a patched `window.open' posts back; gi-webkit2 pulls it anyway.
      , gi-javascriptcore >=4.0 && <4.1
      , gi-webkit2 >=4.0 && <4.1
      -- `castTo' downcasts a WebKitPolicyDecision; every gi-* already pulls it.
      , haskell-gi-base >=0.26 && <0.27
      , text
      , unix
  default-language: Haskell2010

-- The WASM probe: the core inside a WASI runtime — `make run-wasm`.  Buildable
-- only under `pure-crypto`, so app/ stays one executable in every other build.
executable glance-wasm-probe
  main-is: WasmProbe.hs
  hs-source-dirs:
      app
  default-extensions:
      OverloadedStrings
  ghc-options: -Wall -Werror=incomplete-patterns
  build-depends:
      base >=4.7 && <5
    , glance
    , text
  if !flag(pure-crypto)
    buildable: False
  default-language: Haskell2010

executable glance
  main-is: Main.hs
  other-modules:
      Scan
  hs-source-dirs:
      app
  default-extensions:
      OverloadedStrings
      RecordWildCards
      FlexibleInstances
  ghc-options: -Wall -Werror=incomplete-patterns -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , glance:{glance-desktop-native, glance-internal, glance-migrate, glance-web}
    , haskeline
    , megaparsec
    , text
    , text-show
    , time
  default-language: Haskell2010

test-suite glance-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      TestCli
      TestConfig
      TestDefaults
      TestEdit
      TestExternal
      TestFilter
      TestGen
      TestIndex
      TestParser
      TestProperties
      TestQuery
      TestRoundtrip
      TestSelfContained
      TestServe
      TestStore
      TestSubtree
      TestTimestamp
      TestWire
      TestContext
      TestDesktop
      TestNegative
      TestTextShow
      TestSpans
      TestSpec
    -- The domain model itself (AGENTS.hs at the repo root), compiled so 'TestSpec'
    -- can ask its registries of the real code.  No library may depend on the spec.
      AGENTS
  hs-source-dirs:
      test
      .
  default-extensions:
      OverloadedStrings
      RecordWildCards
      FlexibleInstances
  ghc-options: -Wall -Werror=incomplete-patterns -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , QuickCheck
    , aeson
    , async
    , bytestring
    , containers
    , directory
    , filepath
    -- `glance-desktop-native' is trivial and base-only while `native-window' is
    -- off, so depending on it puts no GTK in the way of building the suite; it
    -- is what lets 'TestDesktop' call `zoomAsked' rather than read its source.
    , glance:{glance, glance-desktop-native, glance-internal, glance-migrate, glance-web}
    , http-types
    , process
    , stm
    , tasty
    , tasty-hunit
    , text
    , text-show
    , time
    , unix
    , zlib
    , wai
    , wai-extra
  default-language: Haskell2010
