cabal-version: 3.0

name:           glance
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/rails-to-cosmos/glance#readme>
homepage:       https://github.com/rails-to-cosmos/glance#readme
bug-reports:    https://github.com/rails-to-cosmos/glance/issues
author:         Dmitry Akatov
maintainer:     dmitry.akatov@protonmail.com
copyright:      Dmitry Akatov
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    CHANGELOG.md
    test/fixtures/*.json
    test/fixtures/broken/*.org
    test/fixtures/view/*.org

source-repository head
  type: git
  location: https://github.com/rails-to-cosmos/glance

-- The parser and its AST.  Private: only this package's own components may
-- depend on it, so a future daemon or web target cannot reach past the facade.
library glance-internal
  visibility: private
  exposed-modules:
      Data.Org
      Data.Org.Types
      Data.Org.Parser
      Data.Org.Walk
      Repl.Org
  hs-source-dirs:
      src
  default-extensions:
      FlexibleInstances
      GADTs
      OverloadedRecordDot
      OverloadedStrings
      RecordWildCards
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , containers
    , directory
    , filepath
    , haskeline
    , megaparsec
    , mtl
    , text
    , text-show
    , time
  default-language: Haskell2010

-- The public library: the query facade and nothing else.  Everything outside
-- this package sees only 'Glance.Query'.
library
  exposed-modules:
      Glance.Query
  hs-source-dirs:
      src-query
  default-extensions:
      OverloadedStrings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , aeson
    , bytestring
    , containers
    , glance:glance-internal
    , text
    , text-show
    , time
  default-language: Haskell2010

executable glance
  main-is: Main.hs
  other-modules:
      Scan
  hs-source-dirs:
      app
  default-extensions:
      OverloadedStrings
      RecordWildCards
      FlexibleInstances
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , bytestring
    , directory
    , filepath
    , glance:glance-internal
    , haskeline
    , megaparsec
    , text
    , text-show
    , time
  default-language: Haskell2010

test-suite glance-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      TestDefaults
      TestParser
      TestQuery
      TestRoundtrip
      TestTimestamp
      TestContext
      TestNegative
      TestTextShow
      TestSpans
  hs-source-dirs:
      test
  default-extensions:
      OverloadedStrings
      RecordWildCards
      FlexibleInstances
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , aeson
    , containers
    , glance:{glance, glance-internal}
    , tasty
    , tasty-hunit
    , text
    , text-show
    , time
  default-language: Haskell2010
