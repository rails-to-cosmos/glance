cabal-version: 3.0

name:           glance
version:        0.4.0.0
description:    Please see the README on GitHub at <https://github.com/rails-to-cosmos/glance#readme>
homepage:       https://github.com/rails-to-cosmos/glance#readme
bug-reports:    https://github.com/rails-to-cosmos/glance/issues
author:         Dmitry Akatov
maintainer:     dmitry.akatov@protonmail.com
copyright:      Dmitry Akatov
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    CHANGELOG.md
    -- The renderer glance-web compiles in; vendored by `make sync-renderer'.
    assets/table-view.js
    -- And the shell, one widget per file, concatenated by the TH splice in the
    -- order `Glance.Web.Base.gluePartFiles' declares.
    assets/glue/*.js
    test/fixtures/*.js
    test/fixtures/*.json
    test/fixtures/assets/*.js
    test/fixtures/assets/glue/*.js
    test/fixtures/broken/*.org
    test/fixtures/subtree/*.org
    test/fixtures/view/*.org

source-repository head
  type: git
  location: https://github.com/rails-to-cosmos/glance

-- Build `glance desktop''s own WebKitGTK window instead of borrowing a
-- browser.  Off by default and manual, because on it the solver pulls the
-- haskell-gi tree -- some 28 packages, 25 of them under gi-gtk 3, each
-- generated at build time from the machine's own typelibs -- and the build
-- needs GTK3 and WebKitGTK development files.  Off, nothing above resolves,
-- the suite runs without GTK, and `glance desktop' is exactly stage 1.
--
-- The flag alone is not enough: Hackage's gi-webkit2 binds WebKit2 4.0, and
-- `vendored/' carries it repointed at 4.1.  Turning the flag on therefore
-- means the project file that names those packages, and `make native' is that
-- project file plus the GIR search path it needs.
flag native-window
  description: Build the native WebKitGTK window (gi-gtk 3 + gi-webkit2).
  default: False
  manual: True

-- The WASM build's crypto seam (docs/proposal-native-ports.md): crypton is
-- unbuildable on wasm32-wasi in both directions -- current versions lean on
-- mmap through `ram', older ones on basement's cbits -- and the core uses it
-- for exactly two things, the SHA-256 digest and sixteen random bytes.  On,
-- both come from pure Haskell (SHA, random); off, nothing changes.
flag pure-crypto
  description: Pure-Haskell digest and entropy (wasm32-wasi has no crypton).
  default: False
  manual: True

-- The parser and its AST.  Private: only this package's own components may
-- depend on it, so a future daemon or web target cannot reach past the facade.
library glance-internal
  visibility: private
  exposed-modules:
      Data.Org
      Data.Org.Blob
      Data.Org.Config
      Data.Org.Edit
      Data.Org.External
      Data.Org.Index
      Data.Org.Types
      Data.Org.Parser
      Data.Org.Walk
      Repl.Org
  hs-source-dirs:
      src
  default-extensions:
      FlexibleInstances
      GADTs
      OverloadedRecordDot
      OverloadedStrings
      RecordWildCards
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    -- Read-only, and for ONE foreign format: org-glance's JSONL index, which
    -- 'Data.Org.Index' folds so the scan can say where the two disagree.  No
    -- internal type gains a 'ToJSON' by it -- the wire contract stays hand-built
    -- in 'Glance.Query' (docs/invariants.md, Architecture).
    , aeson
    , async
    , bytestring
    , containers
    , directory
    , filepath
    , haskeline
    , megaparsec
    , mtl
    , text
    , text-show
    , time
    , unix
  if flag(pure-crypto)
    build-depends:
        SHA
      , random
    cpp-options: -DPURE_CRYPTO
  else
    build-depends:
        crypton
  default-language: Haskell2010

-- The public library: the query facade and nothing else.  Everything outside
-- this package sees only 'Glance.Query'.
library
  exposed-modules:
      Glance.Query
  hs-source-dirs:
      src-query
  default-extensions:
      OverloadedStrings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , aeson
    , bytestring
    , containers
    , glance:glance-internal
    , text
    , text-show
    , time
  default-language: Haskell2010

-- The web layer.  Private, and depends on the public library alone: the
-- facade constraint (docs/invariants.md, Architecture) is a solver error here
-- rather than a review note -- adding Data.Org.* to this stanza is impossible
-- without naming glance-internal, which would show up in this build-depends.
library glance-web
  visibility: private
  exposed-modules:
      Glance.Desktop
      Glance.Desktop.Native
      Glance.Web
      Glance.Web.Base
      Glance.Web.Columns
      Glance.Web.Commands
      Glance.Web.Filter
      Glance.Web.Keymap
      Glance.Web.Page
      Glance.Web.Page.Glue
      Glance.Web.Page.Style
      Glance.Web.Routes
      Glance.Web.Sort
      Glance.Web.Store
      Glance.Web.Theme
      Glance.Web.Theme.Default
      Glance.Web.Theme.Types
      Glance.Web.Watch
  hs-source-dirs:
      src-web
  default-extensions:
      OverloadedStrings
      RecordWildCards
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , aeson
    , bytestring
    , containers
    , directory
    , file-embed
    , filepath
    , fsnotify
    , glance:glance
    , http-types
    , process
    , stm
    -- `Routes' folds `gluePartFiles' into one embed per part, which is a TH
    -- list expression; the splice itself was always here.
    , template-haskell
    , text
    , time
    , wai
    , wai-extra
    , wai-websockets
    , warp
    , websockets
  default-language: Haskell2010

-- The native window and nothing else: no daemon, no store, no glance module in
-- its build-depends.  Always built and trivial when `native-window' is off,
-- which is what keeps the flag out of every other stanza -- the rest of the
-- program asks it one question, `nativeAvailable', and gets a Bool.
library glance-desktop-native
  visibility: private
  exposed-modules:
      Glance.Desktop.WebKit
  hs-source-dirs:
      src-desktop-native
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
  if flag(native-window)
    cpp-options: -DNATIVE_WINDOW
    -- gi-gtk3/gi-gdk3 rather than gi-gtk/gi-gdk: same modules, and they are
    -- the names gi-webkit2 depends on, so the unambiguous spelling is what
    -- keeps one GI.Gtk in the plan instead of two packages claiming it.
    build-depends:
        gi-gdk3 >=3.0 && <3.1
      , gi-glib >=2.0 && <2.1
      , gi-gtk3 >=3.0 && <3.1
      -- gi-javascriptcore reads the URL a patched `window.open' posts back
      -- out of the JavaScript world; gi-webkit2 pulls it anyway.
      , gi-javascriptcore >=4.0 && <4.1
      , gi-webkit2 >=4.0 && <4.1
      -- The one non-generated package here, and every gi-* already pulls it:
      -- `castTo' is what turns a WebKitPolicyDecision into the navigation one
      -- that carries the URI, which is what routes a new window to the system
      -- browser instead of losing it.
      , haskell-gi-base >=0.26 && <0.27
      , text
      , unix
  default-language: Haskell2010

-- The WASM probe: the core run inside a WASI runtime — `make run-wasm`.
-- Buildable only under `pure-crypto`, which is the wasm project's flag, so no
-- other build ever sees it and the app/ directory stays one executable
-- everywhere else.
executable glance-wasm-probe
  main-is: WasmProbe.hs
  hs-source-dirs:
      app
  default-extensions:
      OverloadedStrings
  ghc-options: -Wall
  build-depends:
      base >=4.7 && <5
    , glance
    , text
  if !flag(pure-crypto)
    buildable: False
  default-language: Haskell2010

executable glance
  main-is: Main.hs
  other-modules:
      Scan
  hs-source-dirs:
      app
  default-extensions:
      OverloadedStrings
      RecordWildCards
      FlexibleInstances
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , glance:{glance-desktop-native, glance-internal, glance-web}
    , haskeline
    , megaparsec
    , text
    , text-show
    , time
  default-language: Haskell2010

test-suite glance-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      TestConfig
      TestDefaults
      TestEdit
      TestExternal
      TestFilter
      TestIndex
      TestParser
      TestQuery
      TestRoundtrip
      TestSelfContained
      TestServe
      TestStore
      TestSubtree
      TestTimestamp
      TestWire
      TestContext
      TestDesktop
      TestNegative
      TestTextShow
      TestSpans
  hs-source-dirs:
      test
  default-extensions:
      OverloadedStrings
      RecordWildCards
      FlexibleInstances
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , aeson
    , async
    , bytestring
    , containers
    , directory
    , filepath
    , glance:{glance, glance-internal, glance-web}
    , http-types
    , process
    , stm
    , tasty
    , tasty-hunit
    , text
    , text-show
    , time
    , unix
    , wai
    , wai-extra
  default-language: Haskell2010
