#!/usr/bin/env bash
# WHAT THE REPOSITORY IS MADE OF.  A line carrying code AND a trailing comment is CODE.
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "loc: not a git repository -- SKIPPED" >&2
  exit 0
fi

git ls-files -z | awk -v RS='\0' '
function bucket(path,   b) {
  # NO APOSTROPHE BELOW -- the awk program is single-quoted.
  if (path ~ /^vendored\//)          return "vendored"
  if (path == "assets/table-view.js") return "vendored"
  if (path == "assets/elm.js")        return "generated"
  if (path ~ /^test\/fixtures\//)     return "fixtures"
  # AGENTS.hs IS the design document, written in Haskell.
  if (path == "AGENTS.hs")            return "docs"
  if (path ~ /^docs\//)               return "docs"
  if (path ~ /^(README|CHANGELOG)/)   return "docs"
  if (path ~ /\.(md|org)$/)           return "docs"
  if (path ~ /^test\//)               return "tests"
  return "source"
}
function marker(path) {
  if (path ~ /\.(hs|elm|cabal)$/)          return "--"
  if (path ~ /\.(js|mjs|ts)$/)             return "//"
  if (path ~ /\.el$/)                      return ";"
  if (path ~ /\.(sh|yml|yaml|json5)$/)     return "#"
  if (path ~ /^(Makefile|Eask|.*\.mk)$/)   return "#"
  if (path ~ /^tools\//)                   return "#"
  return ""
}
{ files[$0] = 1 }
END {
  # The file list arrives NUL-separated; the files themselves are lines.
  RS = "\n"
  for (path in files) {
    b = bucket(path); m = marker(path)
    n = 0; c = 0; blank = 0; inblock = 0
    while ((getline line < path) > 0) {
      n++
      stripped = line
      sub(/^[ \t]+/, "", stripped)
      if (inblock) {
        c++
        if ((inblock == 1 && stripped ~ /-\}/) || (inblock == 2 && stripped ~ /\*\//)) inblock = 0
        continue
      }
      if (stripped == "") { blank++; continue }
      if (m != "" && substr(stripped, 1, length(m)) == m) { c++; continue }
      if (stripped ~ /^\{-/) { c++; if (!(stripped ~ /-\}/)) inblock = 1; continue }
      if (stripped ~ /^\/\*/) { c++; if (!(stripped ~ /\*\//)) inblock = 2; continue }
    }
    close(path)
    lines[b] += n; comments[b] += c; blanks[b] += blank; count[b]++
  }
  order = "source tests docs fixtures generated vendored"
  split(order, ord, " ")
  printf "%-11s %6s %8s %9s %8s %7s\n", "", "files", "lines", "code", "comment", "%"
  for (i = 1; i <= 6; i++) {
    b = ord[i]
    if (count[b] == 0) continue
    code = lines[b] - comments[b] - blanks[b]
    pct  = lines[b] ? (100 * comments[b] / lines[b]) : 0
    printf "%-11s %6d %8d %9d %8d %6.1f%%\n", b, count[b], lines[b], code, comments[b], pct
    # DOCS ARE PROSE, so their lines are no denominator for a comment:code ratio.
    if (b == "source" || b == "tests" || b == "fixtures") {
      tf += count[b]; tl += lines[b]; tc += comments[b]; tb += blanks[b]
    }
  }
  printf "%-11s %6d %8d %9d %8d %6.1f%%\n", "code", tf, tl, tl - tc - tb, tc,
         tl ? (100 * tc / tl) : 0
  # THE TARGET IS COMMENT:CODE, 10%; the per-bucket column is comment:lines.
  acode = tl - tc - tb
  budget = int(acode / 10)
  printf "\ncomment:code  %.1f%%   target 10%% (%d lines)   ", acode ? 100 * tc / acode : 0, budget
  if (tc > budget) printf "OVER by %d\n", tc - budget
  else             printf "under by %d\n", budget - tc
}
'
