# TSV: rule <TAB> langs <TAB> kind:needle <TAB> replacement.  langs = comma list
# of hs, js, elm or *; kind = tok (operator token, bounded by the language's
# operator charset), word (\b identifier) or re (perl regex, LOOKAROUNDS ONLY,
# no capture groups); an empty replacement deletes the match.  The four
# STRUCTURAL rules — zero, guard, arms, body — live in tools/mutate-sites.

rel	hs,elm	tok:<=	<
rel	hs,elm	tok:<	<=
rel	hs,elm	tok:>=	>
rel	hs,elm	tok:>	>=
rel	js	tok:<=	<
rel	js	tok:<	<=
rel	js	tok:>=	>
rel	js	tok:>	>=

eq	hs,elm	tok:==	/=
eq	hs,elm	tok:/=	==
eq	js	tok:===	!==
eq	js	tok:!==	===
eq	js	tok:==	!=
eq	js	tok:!=	==

bool	hs,elm	word:True	False
bool	hs,elm	word:False	True
bool	js	word:true	false
bool	js	word:false	true

logic	hs,elm	tok:&&	||
logic	hs,elm	tok:||	&&
logic	js	tok:&&	||
logic	js	tok:||	&&

off-by-one	*	re:\+ 1(?![\w.])	+ 0
off-by-one	*	re:- 1(?![\w.])	+ 1
off-by-one	*	re:(?<![\w.])1 \+	0 +

identity	hs	re:(?<![.\w])reverse\b	id
identity	hs	re:(?<![.\w])nub\b	id
identity	hs	re:\bsortOn\s+\S+	id
identity	hs	re:\bsortBy\s+\S+	id
identity	hs	re:\bT\.strip\b	id
identity	hs	re:\bT\.toLower\b	id
identity	hs	re:\bT\.copy\b	id
identity	js	re:\.trim\(\)
identity	js	re:\.sort\([^()]*\)
identity	js	re:\.toLowerCase\(\)
identity	elm	re:\bList\.reverse\b	identity
identity	elm	re:\bList\.sortBy\s+\S+	identity
identity	elm	re:\bString\.trim\b	identity
identity	elm	re:\bString\.toLower\b	identity
