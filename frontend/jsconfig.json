{
  // `make check-glue' runs this.  The parts are FRAGMENTS of one script scope,
  // so they are checked together and the list is asserted against the build's
  // own `gluePartFiles' by TestSelfContained.
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "allowJs": true,

    // ON, and free: measured 0 errors on 2026-08-14.  This buys
    // strictBindCallApply, strictFunctionTypes, noImplicitThis, alwaysStrict
    // and useUnknownInCatchVariables.
    "strict": true,

    // STAGED, with what they cost measured rather than guessed.
    //
    // 1566 errors on 2026-09-17.  The glue is written without annotations, so
    // this is a per-parameter and boundary-contract job across 5818 lines.
    "noImplicitAny": false,
    // 403 errors on 2026-09-17.  Many are long-lived handles honestly null
    // until a widget mounts; typing those lifecycles is the value of the work.
    "strictNullChecks": false
  },
  "files": [
    "glue/00-core.js",
    "glue/05-keys.js",
    "glue/15-dates.js",
    "glue/20-sheet.js",
    "glue/30-palette.js",
    "glue/35-draft.js",
    "glue/36-date-cell.js",
    "glue/37-tags.js",
    "glue/40-popups.js",
    "glue/50-settings.js",
    "glue/60-refer.js",
    "glue/70-shell.js",
    "glue/80-git.js",
    "table-view.d.ts",
    "glue.d.ts"
  ]
}
